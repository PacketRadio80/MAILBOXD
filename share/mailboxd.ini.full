; MailboxD 1.0.0 — Complete configuration reference
; Packet-radio BBS / mailbox daemon for amateur radio.
;
; Copy sections you need to mailboxd.ini.  Missing keys use compiled-in
; defaults.  INI format: [section] headers, key = value pairs, ; comments.

; ─── [service] ─ Daemon identity and privilege ──────────────────────────
[service]
name            = MAILBX              ; Station callsign (banners, logs)
user            = lighttpd            ; Drop-privilege user after port bind
group           = lighttpd            ; Drop-privilege group
login_announce  = no                  ; Notify other users on login/logout
prompt          =                     ; Command prompt string (empty = off)
max_online      = 0                   ; Max simultaneous sessions (0 = ∞)
nodes           = 0                   ; Virtual node count for /nodes display

; ─── [storage] ─ User/account database ─────────────────────────────────
[storage]
backend         = sqlite              ; sqlite | flatfile
path            = data                ; DB dir (relative to install root)

; ─── [auth] ─ Login behaviour ──────────────────────────────────────────
[auth]
auto_login      = yes                 ; yes → guest session on connect
                                      ; no  → login prompt on connect
guest_prefix    = Guest               ; Guest username prefix (Guest1, …)

; ─── [traffic] ─ Output pacing and display ─────────────────────────────
[traffic]
baud            = 2400                ; Simulated baud for pacing (0 = off)
line_width      = 80                  ; Display wrap width (0 = no wrap)
pace_output     = yes                 ; Throttle output to baud rate?
ansi            = no                  ; Allow ANSI escape sequences?

; ─── [log] ─ Logging ──────────────────────────────────────────────────
[log]
enabled         = yes                 ; Enable file logging?
dir             = logs                ; Log directory (relative to root)
level           = warn                ; off|error|warn|info|debug|trace

; ─── [monitor] ─ Sysop session monitor ─────────────────────────────────
[monitor]
enabled         = yes                 ; /monitor command available?
follow_mailboxd = yes                 ; Follow mailbox session events
follow_security = yes                 ; Follow ban/unban events
invisible-sysop = yes                 ; Hide sysop from /who
invite_timeout_sec = 20               ; Monitor invite timeout (5–300)
allow           =                     ; Allowed users (comma-sep, empty = all sysops)

; ─── [security] ─ Login throttling ─────────────────────────────────────
[security]
enabled         = yes                 ; Fail2ban-style login throttle
telnet          = yes                 ; Track telnet login failures

; ─── [mail] ─ User mailbox ────────────────────────────────────────────
[mail]
enabled         = yes                 ; /mail available?
path            = mail                ; Storage subdir (flatfile) or table prefix (sqlite)
max_messages    = 50                  ; Max messages per inbox
subject_max     = 72                  ; Subject line max length
body_max        = 64                  ; Body max lines
recycle_days    = 30                  ; Days before deleted messages purge (1–365)

; ─── [networks] ─ Transport availability ───────────────────────────────
[networks]
telnet          = yes                 ; Enable telnet transport

; ─── [entertain] ─ Games and AI ────────────────────────────────────────
[entertain]
enabled         = yes                 ; /chess and /aichat available?

; ─── [chat] ─ Live chat channels ───────────────────────────────────────
[chat]
channels        = 4                   ; Number of channels (1–12)
message_max     = 256                 ; Max message length
; channel1     = Local               ; Custom name (default: channel1)
; channel2     = DX
; channel3     = Tech
; channel4     = Ragchew

; ─── [broadcast] ─ Local announces ─────────────────────────────────────
[broadcast]
enabled         = yes                 ; /broadcast (announce to all online)

; ─── [beacon] ─ Autonomous CQ beacon ──────────────────────────────────
[beacon]
enabled         = yes                 ; Periodic CQ via PRTERM?
callerid        = MAILBX              ; AX.25 source callsign
msg             = MAILBX = online     ; Beacon text (over-the-air)
interval        = 150                 ; Min seconds between beacons (≥150)
prterm_url      = http://127.0.0.1/prterm.cgi  ; PRTERM CGI for mbox_cqbeacon POST

; ─── [crypto] ─ Cryptographic backends ─────────────────────────────────
[crypto]
; password_hash = openssl             ; openssl | tinysha256
; aes_gcm       = openssl             ; openssl | tinyaes
; x25519        = openssl             ; openssl | curve25519-donna
; random        = openssl             ; openssl | arc4random | urandom

; ─── [transport.mailboxd_prterm] ─ PRTERM unix-socket bridge ──────────
[transport.mailboxd_prterm]
enabled         = yes                 ; PRTERM link active?
bind            = /var/mailboxd/prterm.sock  ; Socket path
mode            = 0660                ; Socket permissions (octal)
link_token      = CHANGE_ME_TO_RANDOM_HEX   ; Must match prterm.ini [mailboxd] link_token

; ─── [transport.telnet] ─ Telnet server ───────────────────────────────
[transport.telnet]
bind            = 0.0.0.0             ; Listen address
port            = 2323                ; Listen port

; ─── [texts] ─ Banner/MOTD/news files ─────────────────────────────────
[texts]
; path          = text                ; Dir for banner.txt, motd.txt, news.txt, rules.txt